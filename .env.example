# ============================================================
# AI Social Media Manager — Environment Variables EXAMPLE
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_social_media_manager
POSTGRES_PORT=5432
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Application ───────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── Tavily (Feature 1 — required) ─────────────────────────────
# Free key: https://app.tavily.com
TAVILY_API_KEY=

# ── Google Gemini (later features: rate / plan / write) ────────
# Not required for Feature 1 Tavily research.
# Get a free key at: https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Reddit (optional later — API access is gated) ─────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AI-Social-Media-Manager/0.1 (dev; by yourusername)
