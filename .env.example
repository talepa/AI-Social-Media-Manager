# ============================================================
# AI Social Media Manager — Environment Variables EXAMPLE
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_social_media_manager
POSTGRES_PORT=5432
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Application ───────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── Tavily (web research — required) ──────────────────────────
# Free key: https://app.tavily.com
TAVILY_API_KEY=

# ── Google Gemini (research report synthesis — required for /report) ─
# Get a free key at: https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Research cache (same topic → reuse results) ───────────────
RESEARCH_CACHE_ENABLED=true
# 24 hours
RESEARCH_CACHE_TTL_SECONDS=86400
# RESEARCH_CACHE_DIR=backend/.cache/research

# ── Optional: higher Semantic Scholar rate limits ─────────────
# Free key: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=
